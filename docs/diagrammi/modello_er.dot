
digraph ER {
  rankdir=LR; node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#241a17", arrowhead=crow, arrowtail=tee, dir=both];
  utenti [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>utenti</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="nome">nome</td></tr><tr><td align="left" port="cognome">cognome</td></tr><tr><td align="left" port="email">email UNIQUE</td></tr><tr><td align="left" port="password_hash">password_hash</td></tr><tr><td align="left" port="ruolo">ruolo</td></tr><tr><td align="left" port="consenso_privacy">consenso_privacy</td></tr><tr><td align="left" port="data_registrazione">data_registrazione</td></tr><tr><td align="left" port="eliminato_il">eliminato_il</td></tr></table>>];
  sessioni [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>sessioni</b></font></td></tr><tr><td align="left" port="token_hash">token_hash PK</td></tr><tr><td align="left" port="utente_id">utente_id FK</td></tr><tr><td align="left" port="creata_il">creata_il</td></tr><tr><td align="left" port="scade_il">scade_il</td></tr></table>>];
  tentativi_login [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>tentativi_login</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="email">email</td></tr><tr><td align="left" port="ip">ip</td></tr><tr><td align="left" port="quando">quando</td></tr></table>>];
  sale [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>sale</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="nome">nome UNIQUE</td></tr><tr><td align="left" port="capienza">capienza</td></tr></table>>];
  settori [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>settori</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="sala_id">sala_id FK</td></tr><tr><td align="left" port="nome">nome</td></tr><tr><td align="left" port="posti_totali">posti_totali</td></tr><tr><td align="left" port="prezzo_cent">prezzo_cent</td></tr></table>>];
  tariffe [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>tariffe</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="codice">codice UNIQUE</td></tr><tr><td align="left" port="nome">nome</td></tr><tr><td align="left" port="descrizione">descrizione</td></tr><tr><td align="left" port="sconto_pct">sconto_pct</td></tr><tr><td align="left" port="richiede_documento">richiede_documento</td></tr><tr><td align="left" port="attiva">attiva</td></tr></table>>];
  spettacoli [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>spettacoli</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="titolo">titolo</td></tr><tr><td align="left" port="autore">autore</td></tr><tr><td align="left" port="compagnia">compagnia</td></tr><tr><td align="left" port="genere">genere</td></tr><tr><td align="left" port="descrizione">descrizione</td></tr><tr><td align="left" port="durata_minuti">durata_minuti</td></tr><tr><td align="left" port="attivo">attivo</td></tr><tr><td align="left" port="creato_il">creato_il</td></tr></table>>];
  repliche [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>repliche</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="spettacolo_id">spettacolo_id FK</td></tr><tr><td align="left" port="sala_id">sala_id FK</td></tr><tr><td align="left" port="data_ora">data_ora</td></tr><tr><td align="left" port="stato">stato</td></tr><tr><td align="left" port="promemoria_inviato_il">promemoria_inviato_il</td></tr></table>>];
  prezzi_replica [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>prezzi_replica</b></font></td></tr><tr><td align="left" port="replica_id">replica_id PK,FK</td></tr><tr><td align="left" port="settore_id">settore_id PK,FK</td></tr><tr><td align="left" port="prezzo_cent">prezzo_cent</td></tr></table>>];
  prenotazioni [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>prenotazioni</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="codice">codice UNIQUE</td></tr><tr><td align="left" port="utente_id">utente_id FK</td></tr><tr><td align="left" port="replica_id">replica_id FK</td></tr><tr><td align="left" port="settore_id">settore_id FK</td></tr><tr><td align="left" port="tariffa_id">tariffa_id FK</td></tr><tr><td align="left" port="num_posti">num_posti</td></tr><tr><td align="left" port="prezzo_unitario_cent">prezzo_unitario_cent</td></tr><tr><td align="left" port="importo_cent">importo_cent</td></tr><tr><td align="left" port="stato">stato</td></tr><tr><td align="left" port="data_prenotazione">data_prenotazione</td></tr><tr><td align="left" port="annullata_il">annullata_il</td></tr><tr><td align="left" port="check_in_il">check_in_il</td></tr></table>>];
  feedback [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>feedback</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="utente_id">utente_id FK</td></tr><tr><td align="left" port="spettacolo_id">spettacolo_id FK</td></tr><tr><td align="left" port="voto">voto (1-5)</td></tr><tr><td align="left" port="commento">commento</td></tr><tr><td align="left" port="data">data</td></tr></table>>];
  lista_attesa [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>lista_attesa</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="utente_id">utente_id FK</td></tr><tr><td align="left" port="replica_id">replica_id FK</td></tr><tr><td align="left" port="num_posti">num_posti</td></tr><tr><td align="left" port="creata_il">creata_il</td></tr><tr><td align="left" port="notificata_il">notificata_il</td></tr></table>>];
  notifiche [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>notifiche</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="utente_id">utente_id FK</td></tr><tr><td align="left" port="destinatario">destinatario</td></tr><tr><td align="left" port="oggetto">oggetto</td></tr><tr><td align="left" port="corpo">corpo</td></tr><tr><td align="left" port="creata_il">creata_il</td></tr></table>>];
  registro_audit [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>registro_audit</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="quando">quando</td></tr><tr><td align="left" port="utente_id">utente_id</td></tr><tr><td align="left" port="ruolo">ruolo</td></tr><tr><td align="left" port="email">email</td></tr><tr><td align="left" port="ip">ip</td></tr><tr><td align="left" port="azione">azione</td></tr><tr><td align="left" port="esito">esito</td></tr><tr><td align="left" port="oggetto">oggetto</td></tr><tr><td align="left" port="dettagli">dettagli</td></tr></table>>];
  avvisi [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6e1423"><font color="white"><b>avvisi</b></font></td></tr><tr><td align="left" port="id">id PK</td></tr><tr><td align="left" port="quando">quando</td></tr><tr><td align="left" port="regola">regola</td></tr><tr><td align="left" port="gravita">gravita</td></tr><tr><td align="left" port="soggetto">soggetto</td></tr><tr><td align="left" port="descrizione">descrizione</td></tr><tr><td align="left" port="chiave">chiave UNIQUE</td></tr><tr><td align="left" port="gestito_il">gestito_il</td></tr><tr><td align="left" port="gestito_da">gestito_da FK</td></tr><tr><td align="left" port="note">note</td></tr></table>>];
  utenti:id -> sessioni:utente_id;
  utenti:id -> lista_attesa:utente_id;
  utenti:id -> notifiche:utente_id;
  repliche:id -> lista_attesa:replica_id;
  repliche:id -> prezzi_replica:replica_id;
  settori:id -> prezzi_replica:settore_id;
  tariffe:id -> prenotazioni:tariffa_id;
  utenti:id -> avvisi:gestito_da;
  utenti:id -> registro_audit:utente_id [style=dashed, label="senza vincolo"];
  utenti:id -> prenotazioni:utente_id;
  utenti:id -> feedback:utente_id;
  sale:id -> settori:sala_id;
  sale:id -> repliche:sala_id;
  spettacoli:id -> repliche:spettacolo_id;
  spettacoli:id -> feedback:spettacolo_id;
  repliche:id -> prenotazioni:replica_id;
  settori:id -> prenotazioni:settore_id;
}